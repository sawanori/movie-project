# App
ENV=development
DEBUG=true

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=movie-maker
# 本番では Custom Domain (例: https://assets.example.com) が必須。
# r2.dev はレート制限があり開発のみ可。設定手順は docs/runbooks/omni-reference-operations.md 参照。
R2_PUBLIC_URL=https://your-bucket.r2.dev

# OpenAI
OPENAI_API_KEY=sk-your-api-key

# OpenAI Image Generation (GPT Image 2)
# 注意: OpenAI Org Verification が完了していることが必要
OPENAI_IMAGE_MODEL=gpt-image-2

# Google Gemini
GOOGLE_API_KEY=your-google-api-key

# KlingAI (deprecated)
KLING_ACCESS_KEY=your-kling-access-key
KLING_SECRET_KEY=your-kling-secret-key

# Runway API
RUNWAY_API_KEY=your-runway-api-key

# DomoAI API
DOMOAI_API_KEY=your-domoai-api-key

# PiAPI (Kling AI via PiAPI gateway)
PIAPI_API_KEY=your-piapi-api-key
PIAPI_KLING_VERSION=2.6
PIAPI_KLING_MODE=std

# PiAPI Seedance 2.0 Settings
# task_type: "seedance-2-preview" (480p/standard) or "seedance-2-preview-vip" (720p/1080p)
PIAPI_SEEDANCE_TASK_TYPE=seedance-2-preview-vip
# resolution: "720p" (VIP) or "1080p" (VIP, 高コスト $0.50/s)
PIAPI_SEEDANCE_RESOLUTION=720p

# HailuoAI (MiniMax)
HAILUO_API_KEY=your-minimax-api-key-here
HAILUO_MODEL=MiniMax-Hailuo-02
HAILUO_PROMPT_OPTIMIZER=false

# BFL (Black Forest Labs) FLUX.2 API
# Get your API key from https://bfl.ai/
BFL_API_KEY=your-bfl-api-key

# Video Provider Settings
# "runway" (default), "veo", "domoai", "piapi_kling", "hailuo", or "seedance"
VIDEO_PROVIDER=runway

# Unified Gateway Settings
# 統合ゲートウェイ (unified_gateway) の有効化フラグ。既定 False のまま運用する。
# 注意: サーバーサイド・ワークフロー実行のカタログ公開 (GET /api/v1/config/models|
# capabilities|recommended) と「おまかせ」モデル選択は、このフラグに依存しない独立経路
# であり、GATEWAY_ENABLED=False でも動作する。実装は app/core/config.py:73。
GATEWAY_ENABLED=false

# Workflow Server-Side Execution
# プロセス全体で同時に実行する workflow_run 数の上限 (既定 3)。
# Railway 単一プロセス前提の安全弁。超過分は pending で枠が空くまで待機する。
# 実装は app/core/config.py:78 (未設定なら 3)。
WORKFLOW_MAX_CONCURRENT_RUNS=3

# LipSync Provider Settings
# "hedra" or "piapi_kling"
LIP_SYNC_PROVIDER=piapi_kling

# fal.ai (Background Removal)
FAL_KEY=

# Topaz Video API (for 60fps frame interpolation)
# Get your API key from https://www.topazlabs.com/api
TOPAZ_API_KEY=your-topaz-api-key

# Polar (Payment)
POLAR_API_KEY=your-polar-api-key
POLAR_WEBHOOK_SECRET=your-webhook-secret

# Suno API (for BGM generation)
# Use third-party provider like SunoAPI.org since official API is not public
SUNO_API_KEY=your-suno-api-key
SUNO_API_BASE_URL=https://api.sunoapi.org

# Frontend
FRONTEND_URL=http://localhost:3000
